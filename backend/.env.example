PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mini_crm
# Or use a MongoDB Atlas connection string, e.g.:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/mini_crm

JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Used only by seed/createAdmin.js to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@minicrm.com
ADMIN_PASSWORD=Admin@123
